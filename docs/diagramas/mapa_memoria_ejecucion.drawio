        <mxCell id="m25" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.6;fontFamily=Arial;fontSize=14;fontStyle=1;fontColor=#000000;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;dashed=1;" value="Registro pendiente (entre ERA y GOSUB)" vertex="1">
          <mxGeometry height="190" width="320" x="880" y="-53" as="geometry" />
        </mxCell>
        <mxCell id="m26" parent="1" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#000000;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;spacingLeft=4;" value="&lt;b&gt;ERA&lt;/b&gt; (prepareCall): lo crea con el tamaño de la función, buscada por su inicio.&lt;br&gt;&lt;br&gt;&lt;b&gt;PARAM&lt;/b&gt; (writeParam): lee el argumento en la memoria actual y lo escribe en la dirección del parámetro.&lt;br&gt;&lt;br&gt;&lt;b&gt;GOSUB&lt;/b&gt; (enterCall): guarda el cuádruplo de regreso y lo mete a la pila." vertex="1">
          <mxGeometry height="160" width="300" x="890" y="-25" as="geometry" />
        </mxCell>
        <mxCell id="m27" edge="1" parent="1" source="m25" style="endArrow=block;endFill=1;endSize=5;html=1;rounded=0;strokeColor=#000000;strokeWidth=1.4;fontFamily=Arial;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.2;entryDx=0;entryDy=0;" target="m12" value="GOSUB">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m28" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=6;" value="&lt;b&gt;RETURN / ENDFUNC&lt;/b&gt; (exitCall): se borra la cima y se regresa al cuádruplo guardado; RETURN antes copia el valor a la dirección global de regreso." vertex="1">
          <mxGeometry height="80" width="320" x="880" y="250" as="geometry" />
        </mxCell>
        <mxCell id="m29" edge="1" parent="1" source="m12" style="endArrow=block;endFill=1;endSize=5;html=1;rounded=0;strokeColor=#000000;strokeWidth=1.4;fontFamily=Arial;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="m28" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m30" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.6;fontFamily=Arial;fontSize=14;fontStyle=1;fontColor=#000000;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;" value="Cómo una dirección indexa la memoria" vertex="1">
          <mxGeometry height="199" width="320" x="880" y="350" as="geometry" />
        </mxCell>
        <mxCell id="m31" parent="1" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#000000;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;spacingLeft=4;" value="1. &lt;b&gt;rango&lt;/b&gt; = dirección / 1000 → segmento y tipo (VirtualMemory.rangeOf)&lt;br&gt;2. &lt;b&gt;casilla&lt;/b&gt; = dirección − base (VirtualMemory.cellOf)&lt;br&gt;3. global y constante: bloque fijo; local y temporal: registro de la &lt;b&gt;cima&lt;/b&gt;&lt;br&gt;4. el tipo elige el arreglo y la casilla, la posición&lt;br&gt;&lt;b style=&quot;color: light-dark(rgb(0, 127, 255), rgb(0, 127, 255));&quot;&gt;&lt;br&gt;&lt;font&gt;Ejemplo: 4001&lt;/font&gt;&lt;/b&gt; → rango 4 = local float → cima, float[1]" vertex="1">
          <mxGeometry height="169" width="300" x="890" y="380" as="geometry" />
        </mxCell>
        <mxCell id="m32" edge="1" parent="1" source="m30" style="endArrow=block;endFill=1;endSize=5;html=1;rounded=0;strokeColor=#001DBC;strokeWidth=2.2;exitX=0;exitY=0.85;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;fillColor=#0050ef;" target="m15" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
