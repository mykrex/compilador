        <mxCell id="m10" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=6;" value="Cada arreglo es primitivo (int[ ], double[ ], boolean[ ], String[ ]) y mide lo que guarda el directorio de funciones.&lt;br&gt;&lt;br&gt;Cada arreglo tiene un &lt;b&gt;BitSet&lt;/b&gt;: escribir marca la casilla; leer una casilla sin marca es un error de ejecución." vertex="1">
