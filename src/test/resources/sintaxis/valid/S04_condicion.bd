// S04: if sin else, if con else, if anidado y los 4 operadores relacionales
program _Condicion_ ;
var _X_, _Y_ : int;
main {
    _X_ = 5;
    if (_X_ > 0) { _Y_ = 1; };
    if (_X_ < 0) { _Y_ = -1; } else { _Y_ = 1; };
    if (_X_ == 5) {
        if (_Y_ != 0) { print("anidado"); } else { print("cero"); };
    };
}
end
