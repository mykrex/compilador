// S03: Precedencia, paréntesis, signo unario (en id, constante, paréntesis
//      y llamada) y llamadas a función dentro de expresiones
program _Expresiones_ ;
var _A_, _B_, _C_ : int;
    _F_ : float;

int _Doble_(_N_ : int) [ { return _N_ * 2; } ];

main {
    _A_ = 2 + 3 * 4;
    _B_ = (2 + 3) * 4 - _A_ / 2;
    _C_ = -_A_ + -(_B_ - 1) * -_Doble_(3);
    _F_ = +3.14 * _Doble_(_A_ + 1) / 2.0;
}
end
