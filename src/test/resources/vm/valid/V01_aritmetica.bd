// V01: aritmética con precedencia y paréntesis, signo, división que siempre da float y promoción float ← int
program _V01_;
var _A_, _B_ : int; _F_ : float;
main {
    _A_ = 7;
    _B_ = 2;
    print(_A_ + _B_ * 3);
    print((_A_ + _B_) * 3);
    print(_A_ - _B_ - 1);
    print(-_A_ + 10);
    print(_A_ / _B_);
    print(_A_ * 1.5);
    _F_ = _A_;
    print(_F_);
    _F_ = _F_ / 4 + 0.25;
    print(_F_);
    print(-(_A_ - 10) * 2);
}
end

// salida:
// 13
// 27
// 4
// 3
// 3.5
// 10.5
// 7.0
// 2.0
// 6
