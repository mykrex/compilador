// Q03: precedencia mixta y los cuatro relacionales
program _Q03_;
var _A_, _B_, _C_ : int;
    _F_ : float;
main {
    _F_ = _A_ + _B_ * _C_ / 2 - 1.5;
    print(_A_ + 1 > _B_ * 2, _A_ < _B_, _A_ == _C_, _A_ != 2.5);
}
end

// cuadruplos:
// 0 GOTO _ _ 1
// 1 * _B_ _C_ t1
// 2 / t1 2 t2
// 3 + _A_ t2 t3
// 4 - t3 1.5 t4
// 5 = t4 _ _F_
// 6 + _A_ 1 t5
// 7 * _B_ 2 t6
// 8 > t5 t6 t7
// 9 PRINT t7 _ _
// 10 < _A_ _B_ t8
// 11 PRINT t8 _ _
// 12 == _A_ _C_ t9
// 13 PRINT t9 _ _
// 14 != _A_ 2.5 t10
// 15 PRINT t10 _ _
// 16 PRINTLN _ _ _
// 17 END _ _ _
