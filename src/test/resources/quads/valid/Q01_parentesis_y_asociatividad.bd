// Q01: paréntesis (fondo falso) y asociatividad izquierda
program _Q01_;
var _A_, _B_, _C_, _X_ : int;
main {
    _X_ = _A_ * (_B_ + _C_);
    _X_ = (_A_ + _B_) * _C_;
    _X_ = _A_ - (_B_ - _C_);
    _X_ = _A_ - _B_ - _C_;
}
end

// cuadruplos:
// 0 + _B_ _C_ t1
// 1 * _A_ t1 t2
// 2 = t2 _ _X_
// 3 + _A_ _B_ t3
// 4 * t3 _C_ t4
// 5 = t4 _ _X_
// 6 - _B_ _C_ t5
// 7 - _A_ t5 t6
// 8 = t6 _ _X_
// 9 - _A_ _B_ t7
// 10 - t7 _C_ t8
// 11 = t8 _ _X_
// 12 END _ _ _
