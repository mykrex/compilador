// Q01: paréntesis (fondo falso) y asociatividad izquierda
program _Q01_;
var _A_, _B_, _C_, _X_ : int;
main {
    _X_ = _A_ * (_B_ + _C_);
    _X_ = (_A_ + _B_) * _C_;
    _X_ = _A_ - (_B_ - _C_);
    _X_ = _A_ - _B_ - _C_;
}
end

// cuadruplos:
// 0 GOTO _ _ 1
// 1 + _B_ _C_ t1
// 2 * _A_ t1 t2
// 3 = t2 _ _X_
// 4 + _A_ _B_ t3
// 5 * t3 _C_ t4
// 6 = t4 _ _X_
// 7 - _B_ _C_ t5
// 8 - _A_ t5 t6
// 9 = t6 _ _X_
// 10 - _A_ _B_ t7
// 11 - t7 _C_ t8
// 12 = t8 _ _X_
// 13 END _ _ _
