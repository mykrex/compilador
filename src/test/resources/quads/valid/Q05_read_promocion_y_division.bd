// Q05: read, promoción int -> float sin cuádruplo de conversión, y división
program _Q05_;
var _A_, _B_ : int;
    _F_ : float;
main {
    read(_A_);
    read(_F_);
    _F_ = _A_;
    _F_ = 7 / 2;
    _F_ = _A_ / _B_ + _A_ * _B_;
}
end

// cuadruplos:
// 0 GOTO _ _ 1
// 1 READ _ _ _A_
// 2 READ _ _ _F_
// 3 = _A_ _ _F_
// 4 / 7 2 t1
// 5 = t1 _ _F_
// 6 / _A_ _B_ t2
// 7 * _A_ _B_ t3
// 8 + t2 t3 t4
// 9 = t4 _ _F_
// 10 END _ _ _
