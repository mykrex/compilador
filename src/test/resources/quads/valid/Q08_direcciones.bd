// Q08: direcciones de globales, parámetros, locales, temporales por función y constantes sin repetir
program _Q08_;
var _G_ : int;
    _H_ : float;
void _F_(_P_ : int, _Q_ : float) [
    var _L_ : int;
    {
        _L_ = _P_ + 2;
        _H_ = _Q_ * 2.5;
        print("hola", _L_ > _G_);
    }
];
main {
    _G_ = _G_ + 2;
    _H_ = _H_ / 2.50;
    print("hola");
}
end

// Globales: _G_ 1000, _H_ 2000. En _F_: _P_ 3000, _Q_ 4000 (parámetros primero), _L_ 3001.
// Constantes: 2 -> 8000, 2.5 y 2.50 -> 9000 (mismo valor), "hola" -> 10000 (una sola vez).
// Los temporales reinician su dirección en main (t4 vuelve a 5000, t5 a 6000); el nombre sigue.

// cuadruplos:
// 0 GOTO _ _ 10
// 1 + _P_ 2 t1
// 2 = t1 _ _L_
// 3 * _Q_ 2.5 t2
// 4 = t2 _ _H_
// 5 PRINT "hola" _ _
// 6 > _L_ _G_ t3
// 7 PRINT t3 _ _
// 8 PRINTLN _ _ _
// 9 ENDFUNC _ _ _
// 10 + _G_ 2 t4
// 11 = t4 _ _G_
// 12 / _H_ 2.50 t5
// 13 = t5 _ _H_
// 14 PRINT "hola" _ _
// 15 PRINTLN _ _ _
// 16 END _ _ _

// direcciones:
// 0 15 _ _ 10
// 1 1 3000 8000 5000
// 2 9 5000 _ 3001
// 3 3 4000 9000 6000
// 4 9 6000 _ 2000
// 5 11 10000 _ _
// 6 5 3001 1000 7000
// 7 11 7000 _ _
// 8 12 _ _ _
// 9 21 _ _ _
// 10 1 1000 8000 5000
// 11 9 5000 _ 1000
// 12 4 2000 9000 6000
// 13 9 6000 _ 2000
// 14 11 10000 _ _
// 15 12 _ _ _
// 16 14 _ _ _
