// Q02: signo unario y constantes negativas
program _Q02_;
var _A_, _X_ : int;
    _F_ : float;
main {
    _X_ = -2;
    _X_ = -_A_;
    _X_ = -(_A_ + 1);
    _X_ = _A_ - -2;
    _X_ = +_A_;
    _X_ = -2147483648;
    _F_ = -3.5 * -(2);
}
end

// cuadruplos:
// 0 GOTO _ _ 1
// 1 = -2 _ _X_
// 2 UMINUS _A_ _ t1
// 3 = t1 _ _X_
// 4 + _A_ 1 t2
// 5 UMINUS t2 _ t3
// 6 = t3 _ _X_
// 7 - _A_ -2 t4
// 8 = t4 _ _X_
// 9 = _A_ _ _X_
// 10 = -2147483648 _ _X_
// 11 UMINUS 2 _ t5
// 12 * -3.5 t5 t6
// 13 = t6 _ _F_
// 14 END _ _ _
