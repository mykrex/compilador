// Q09: if sin else, if-else y while con un if anidado (GOTOF y GOTO rellenados)
program _Q09_;
var _A_, _B_ : int;
main {
    if (_A_ > 0) {
        _B_ = 1;
    };
    if (_A_ < _B_) {
        _A_ = 2;
    } else {
        _A_ = 3;
    };
    while (_A_ != 0) do {
        if (_A_ > 5) {
            print(_A_);
        };
        _A_ = _A_ - 1;
    };
}
end

// if sin else: el GOTOF (1) salta al cuádruplo que sigue al cuerpo (3).
// if-else: el GOTOF (4) salta al else (7) y el GOTO (6) salta al final (8).
// while: el GOTO (16) regresa a la condición (8) y el GOTOF (9) sale del ciclo (17);
// el if anidado (11) salta dentro del cuerpo del while (14).

// cuadruplos:
// 0 > _A_ 0 t1
// 1 GOTOF t1 _ 3
// 2 = 1 _ _B_
// 3 < _A_ _B_ t2
// 4 GOTOF t2 _ 7
// 5 = 2 _ _A_
// 6 GOTO _ _ 8
// 7 = 3 _ _A_
// 8 != _A_ 0 t3
// 9 GOTOF t3 _ 17
// 10 > _A_ 5 t4
// 11 GOTOF t4 _ 14
// 12 PRINT _A_ _ _
// 13 PRINTLN _ _ _
// 14 - _A_ 1 t5
// 15 = t5 _ _A_
// 16 GOTO _ _ 8
// 17 END _ _ _

// direcciones:
// 0 5 1000 8000 7000
// 1 16 7000 _ 3
// 2 9 8001 _ 1001
// 3 6 1000 1001 7001
// 4 16 7001 _ 7
// 5 9 8002 _ 1000
// 6 15 _ _ 8
// 7 9 8003 _ 1000
// 8 8 1000 8000 7002
// 9 16 7002 _ 17
// 10 5 1000 8004 7003
// 11 16 7003 _ 14
// 12 11 1000 _ _
// 13 12 _ _ _
// 14 2 1000 8001 5000
// 15 9 5000 _ 1000
// 16 15 _ _ 8
// 17 14 _ _ _
