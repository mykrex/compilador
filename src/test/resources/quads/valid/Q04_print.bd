// Q04: print con letreros, varios elementos y un PRINTLN por estatuto
program _Q04_;
var _A_, _B_ : int;
main {
    print("a");
    print("b");
    print("total: ", _A_, " y ", _A_ + _B_);
    print("dice \"hola\"");
}
end

// cuadruplos:
// 0 GOTO _ _ 1
// 1 PRINT "a" _ _
// 2 PRINTLN _ _ _
// 3 PRINT "b" _ _
// 4 PRINTLN _ _ _
// 5 PRINT "total: " _ _
// 6 PRINT _A_ _ _
// 7 PRINT " y " _ _
// 8 + _A_ _B_ t1
// 9 PRINT t1 _ _
// 10 PRINTLN _ _ _
// 11 PRINT "dice \"hola\"" _ _
// 12 PRINTLN _ _ _
// 13 END _ _ _
