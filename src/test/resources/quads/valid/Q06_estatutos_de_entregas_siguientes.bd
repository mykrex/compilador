// Q06: if-else y while con saltos; funciones y llamadas: se genera lo lineal y se dejan notas
program _Q06_;
var _A_, _B_, _X_ : int;
int _Doble_(_P_ : int) [ {
    return _P_ * 2;
} ];
void _Muestra_(_V_ : int) [ {
    print(_V_);
} ];
main {
    _X_ = _A_ * _Doble_(_B_ + 1);
    if (_X_ > 10) {
        _Muestra_(_X_);
    } else {
        _X_ = 0;
    };
    while (_A_ < 3) do {
        _A_ = _A_ + 1;
    };
}
end

// cuadruplos:
// 0 * _P_ 2 t1
// 1 PRINT _V_ _ _
// 2 PRINTLN _ _ _
// 3 + _B_ 1 t2
// 4 * _A_ t3 t4
// 5 = t4 _ _X_
// 6 > _X_ 10 t5
// 7 GOTOF t5 _ 9
// 8 GOTO _ _ 10
// 9 = 0 _ _X_
// 10 < _A_ 3 t6
// 11 GOTOF t6 _ 15
// 12 + _A_ 1 t7
// 13 = t7 _ _A_
// 14 GOTO _ _ 10
// 15 END _ _ _
// notas:
// nota: 0 aquí irá Goto a main
// nota: 0 inicio de la función _Doble_
// nota: 1 return: aquí irá RETURN t1
// nota: 1 fin de la función _Doble_: aquí irá ENDFUNC
// nota: 1 inicio de la función _Muestra_
// nota: 3 fin de la función _Muestra_: aquí irá ENDFUNC
// nota: 3 inicio de main: aquí se rellenará el Goto a main
// nota: 3 llamada a _Doble_ (línea 11): aquí irá ERA _Doble_
// nota: 4 aquí irá PARAM t2 (argumento 1)
// nota: 4 aquí irá GOSUB _Doble_; t3 recibirá su valor de retorno
// nota: 8 llamada a _Muestra_ (línea 13): aquí irá ERA _Muestra_
// nota: 8 aquí irá PARAM _X_ (argumento 1)
// nota: 8 aquí irá GOSUB _Muestra_
